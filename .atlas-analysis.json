  "keyFeatures": [
    "Full RDP client implementation supporting modern RDP protocol versions",
    "Multi-platform support: Linux (X11, Wayland), Windows, macOS, Android, iOS",
    "SDL2/SDL3-based cross-platform client (sdl-freerdp)",
    "Embeddable C library (libfreerdp) for custom RDP client/server applications",
    "Server-side RDP implementation with freerdp_peer API",
    "RDP proxy with pluggable module system",
    "Extensive virtual channel support (clipboard, audio, drive redirection, USB, smartcard, graphics)",
    "Hardware-accelerated graphics via RDP GFX (H.264/AVC, RFX, NSCodec)",
    "NLA authentication (NTLM, Kerberos, smartcard/PKCS11)",
    "WinPR: Windows Portable Runtime compatibility library"
  ],
  "publicApiSurface": [
    "freerdp_new() / freerdp_free()",
    "freerdp_connect() / freerdp_disconnect()",
    "freerdp_settings_get_*() / freerdp_settings_set_*()",
    "rdpContext (client context lifecycle)",
    "freerdp_peer_new() / freerdp_peer_free() (server peer API)",
    "freerdp_listener_new() (server listener API)",
    "rdpClientEntry / RDP_CLIENT_ENTRY_POINTS (client entry points interface)",
    "WLog (wlog API for hierarchical logging)",
    "freerdp_client_settings_parse_command_line()",
    "rdpChannels / virtual channel plugin API (DVCs, SVCs)",
    "RdpgfxClientContext / clipboard / audio channel contexts",
    "freerdp_certificate_* (TLS certificate utilities)",
    "primitives API (optimized pixel operations)"
  ]
}
